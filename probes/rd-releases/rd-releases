#!/bin/bash
#
# Check whether the latest Rancher Desktop release appears in the update channel.
#
# Parameters (environment variables):
#   PROBE_WARN_DAYS     - Days until warning if release missing (default: 4)
#   PROBE_CRITICAL_DAYS - Days until critical alert (default: 7)
#
# Authentication (checked in order):
#   GH_TOKEN, GITHUB_TOKEN, or `gh auth token`

set -euo pipefail

if [[ "${1:-}" == "--describe" ]]; then
    cat <<'EOF'
{
  "name": "rd-releases",
  "description": "Check if the latest Rancher Desktop release is in the update channel",
  "version": "1.1.0",
  "default_name": "Rancher Desktop Releases",
  "default_interval": "6h",
  "arguments": {
    "optional": {
      "Warn Days": {
        "type": "number",
        "description": "Days after release to warn if not in update channel",
        "default": 4
      },
      "Critical Days": {
        "type": "number",
        "description": "Days after release to go critical if not in update channel",
        "default": 7
      }
    }
  },
  "output": {
    "metrics": {
      "days_since_release": {"type": "integer", "unit": "count", "description": "Days since release"},
      "warn_days": {"type": "integer", "unit": "count", "description": "Warning threshold"},
      "critical_days": {"type": "integer", "unit": "count", "description": "Critical threshold"}
    },
    "data": {
      "latest_version": {"type": "string", "description": "Latest GitHub release version"},
      "channel_version": {"type": "string", "description": "Version in update channel"},
      "published_at": {"type": "string", "description": "Release publish date (RFC3339)"}
    }
  }
}
EOF
    exit 0
fi

GITHUB_API="https://api.github.com/repos/rancher-sandbox/rancher-desktop/releases"
UPDATE_CHANNEL="https://desktop.version.rancher.io/v1/checkupgrade"
RELEASE_URL_BASE="https://github.com/rancher-sandbox/rancher-desktop/releases/tag"

warn_days="${PROBE_WARN_DAYS:-4}"
critical_days="${PROBE_CRITICAL_DAYS:-7}"

# Format a relative time description
format_relative_time() {
    local days=$1
    if [[ $days -eq 0 ]]; then
        echo "today"
    elif [[ $days -eq 1 ]]; then
        echo "yesterday"
    elif [[ $days -lt 7 ]]; then
        echo "$days days ago"
    elif [[ $days -lt 14 ]]; then
        echo "1 week ago"
    elif [[ $days -lt 30 ]]; then
        echo "$((days / 7)) weeks ago"
    elif [[ $days -lt 60 ]]; then
        echo "1 month ago"
    else
        echo "$((days / 30)) months ago"
    fi
}

# Format date as "Jan 15, 2025" using jq for portability
format_date() {
    local iso_date=$1
    echo "$iso_date" | jq -rR '
        split("T")[0] |
        split("-") |
        .[1] as $m | .[2] as $d | .[0] as $y |
        (["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"][($m | tonumber) - 1]) + " " + $d + ", " + $y
    ' 2>/dev/null || echo "$iso_date"
}

output_result() {
    jq --null-input \
        --arg status "$1" \
        --arg summary "$2" \
        --arg message "$3" \
        --argjson days_since "$days_since" \
        --argjson warn_days "$warn_days" \
        --argjson critical_days "$critical_days" \
        --arg latest_version "$latest_version" \
        --arg channel_version "$channel_version" \
        --arg published_at "$published_at" \
        '{
            status: $status,
            summary: $summary,
            message: $message,
            metrics: {
                days_since_release: $days_since,
                warn_days: $warn_days,
                critical_days: $critical_days
            },
            data: {
                latest_version: $latest_version,
                channel_version: $channel_version,
                published_at: $published_at
            }
        }'
}

output_error() {
    jq --null-input --arg message "$1" '{status: "unknown", message: $message}'
    exit 0
}

# Resolve GitHub token
token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
if [[ -z "$token" ]] && command -v gh &>/dev/null; then
    token=$(gh auth token 2>/dev/null) || true
fi

curl_github() {
    if [[ -n "$token" ]]; then
        curl --silent --fail --header "Authorization: Bearer $token" "$1"
    else
        curl --silent --fail "$1"
    fi
}

# Fetch latest GitHub release
github_response=$(curl_github "$GITHUB_API/latest") || output_error "Failed to fetch GitHub release"

# Extract version (strip leading 'v') and published date
read -r latest_version published_at < <(
    echo "$github_response" | jq -r '[(.tag_name | ltrimstr("v")), .published_at] | @tsv'
) || output_error "Failed to parse GitHub response"

if [[ -z "$latest_version" || "$latest_version" == "null" ]]; then
    output_error "No release found on GitHub"
fi

# Fetch update channel
channel_response=$(curl --silent --fail -X POST "$UPDATE_CHANNEL" -d '{}') || output_error "Failed to fetch update channel"

# Find the version tagged as "latest" in the update channel
channel_version=$(echo "$channel_response" | jq -r '.versions[] | select(.Tags[]? == "latest") | .Name') || output_error "Failed to parse update channel response"

if [[ -z "$channel_version" ]]; then
    output_error "No version tagged as 'latest' in update channel"
fi

# Calculate days since release
now_epoch=$(date "+%s")
published_epoch=$(echo "$published_at" | jq -rR 'try fromdate') || output_error "Failed to parse release date"
days_since=$(( (now_epoch - published_epoch) / 86400 ))

# Fetch channel version's release date if different from latest
channel_published_at=""
channel_days_since=0
if [[ "$latest_version" != "$channel_version" ]]; then
    channel_response=$(curl_github "$GITHUB_API/tags/v$channel_version" 2>/dev/null) || true
    if [[ -n "$channel_response" ]]; then
        channel_published_at=$(echo "$channel_response" | jq -r '.published_at // empty')
        if [[ -n "$channel_published_at" ]]; then
            channel_epoch=$(echo "$channel_published_at" | jq -rR 'try fromdate') || true
            if [[ -n "$channel_epoch" ]]; then
                channel_days_since=$(( (now_epoch - channel_epoch) / 86400 ))
            fi
        fi
    fi
fi

# Build URLs
latest_url="$RELEASE_URL_BASE/v$latest_version"
channel_url="$RELEASE_URL_BASE/v$channel_version"

# Format dates for display
latest_date_formatted=$(format_date "$published_at")
latest_relative=$(format_relative_time "$days_since")

# Build detailed message
build_message() {
    local msg="[Release $latest_version]($latest_url) was published on $latest_date_formatted ($latest_relative)."

    if [[ "$latest_version" == "$channel_version" ]]; then
        msg="$msg\n\nThis release is available in the update channel."
    elif [[ -n "$channel_published_at" ]]; then
        local channel_date_formatted=$(format_date "$channel_published_at")
        local channel_relative=$(format_relative_time "$channel_days_since")
        msg="$msg\n\nThe update channel has [release $channel_version]($channel_url), published on $channel_date_formatted ($channel_relative)."
    else
        msg="$msg\n\nThe update channel has [release $channel_version]($channel_url)."
    fi

    echo -e "$msg"
}

# Check if latest release is in the update channel
if [[ "$latest_version" == "$channel_version" ]]; then
    message=$(build_message)
    output_result "ok" "$latest_version in channel" "$message"
elif [[ "$days_since" -gt "$critical_days" ]]; then
    message=$(build_message)
    output_result "critical" "$latest_version missing ($days_since days)" "$message"
elif [[ "$days_since" -gt "$warn_days" ]]; then
    message=$(build_message)
    output_result "warning" "$latest_version missing ($days_since days)" "$message"
else
    message=$(build_message)
    output_result "ok" "$latest_version pending ($days_since days)" "$message"
fi
